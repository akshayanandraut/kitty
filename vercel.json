{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "main": false, "*": false } },
  "rewrites": [
    { "source": "/auth/start", "destination": "/api/auth/start" },
    { "source": "/auth/callback", "destination": "/api/auth/callback" },
    { "source": "/api/account/profile", "destination": "/api/member?route=profile" },
    { "source": "/api/groups/:route", "destination": "/api/member?route=:route" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'" }
    ] }
  ]
}
